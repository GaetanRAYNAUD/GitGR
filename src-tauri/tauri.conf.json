{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGR",
  "version": "../package.json",
  "identifier": "fr.gitgr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "GitGR",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm", "app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Client Git visuel, multi-profils et multi-dépôts",
    "license": "MIT",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/gitgr.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/gitgr.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBRjExMkJFOTcxMjMxODEKUldTQk1SS1h2aEx4S3BySlRmQzFEUS9hREdzRVF4T28zS2JRUTVGY2h2T01zRHdYQnUyRTVRTmwK",
      "endpoints": ["https://github.com/GaetanRAYNAUD/GitGR/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
